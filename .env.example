# =============================================================================
# Cấu hình chạy bằng Docker. Không bắt buộc: không có file .env thì dùng giá trị mặc định bên dưới.
# Muốn đổi: copy file này thành .env rồi sửa (file .env đã nằm trong .gitignore, không bị đẩy lên GitHub).
#   Windows PowerShell:  Copy-Item .env.example .env
# =============================================================================

# --- Đường dẫn repo frontend (mặc định nằm cạnh repo backend) ---
FRONTEND_DIR=../ERP-Sales-Inventory-Frontend

# --- Cổng mở ra máy thật ---
FRONTEND_PORT=3000
# Giữ 8080: giao diện mặc định gọi API ở http://<tên máy>:8080.
# Nếu đổi cổng này thì phải đặt VITE_API_BASE_URL bên dưới cho khớp.
BACKEND_PORT=8080
# 5433 để không trùng PostgreSQL đã cài sẵn trên máy (5432)
DB_PORT=5433

# --- Cơ sở dữ liệu trong container ---
DB_NAME=erp_db
DB_USER=postgres
DB_PASSWORD=123456

# --- Địa chỉ giao diện dùng trong link email (kích hoạt tài khoản, quên mật khẩu) ---
PUBLIC_FRONTEND_URL=http://localhost:3000

# --- Địa chỉ API cho giao diện (để trống = http://<tên máy đang mở web>:8080) ---
# Ví dụ khi đưa lên server có tên miền: VITE_API_BASE_URL=https://api.ten-mien.vn
VITE_API_BASE_URL=

# --- Bí mật (tuỳ chọn). Bỏ dấu # và điền để ghi đè application.properties ---
# ERP_APP_JWTSECRET=chuoi-bi-mat-dai-it-nhat-64-ky-tu-dung-de-ky-token-dang-nhap-cua-he-thong
# SPRING_MAIL_USERNAME=email-gui-thu@gmail.com
# SPRING_MAIL_PASSWORD=mat-khau-ung-dung-gmail
# ERP_APP_MAILFROM=email-gui-thu@gmail.com
